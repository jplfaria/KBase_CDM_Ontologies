        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>For diploid organisms, such as humans, it is the normal condition, whilst for organisms that are normally triploid or above, disomy is an aneuploidy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pato/pato-base.owl"/>
        <rdfs:label>disomy</rdfs:label>
