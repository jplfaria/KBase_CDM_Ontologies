    <!-- http://purl.obolibrary.org/obo/ENVO_01001324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001313"/>
