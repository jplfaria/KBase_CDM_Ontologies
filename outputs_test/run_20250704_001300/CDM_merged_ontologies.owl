        <oboInOwl:hasRelatedSynonym>embryonic circulatory system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fetal circulatory system</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>embryonic cardiovascular system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011779">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001021"/>
