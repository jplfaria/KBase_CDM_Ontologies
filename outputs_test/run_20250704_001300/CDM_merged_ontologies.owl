    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000160"/>
        <obo:IAO_0000115>An animal habitation that is assembled by a wasp. These may be in the ground, in wall cavities, or in sheltered areas.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T20:41:04Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">nest of wasp</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000172"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An animal habitation that is assembled by a wasp. These may be in the ground, in wall cavities, or in sheltered areas.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Nest</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00005803"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000033"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002507"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000500"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An animal habitation created by a beaver, constructed within or adjacent to the pond created by the beaver dam.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T20:56:27Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">beaver lodge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000171"/>
        <obo:IAO_0000115>An animal construction created by leaf-cutter ants that is composed of various materials that result from the ants&apos; activities and behaviors, including degraded plant material, microbial communities, organic material, dead ants and fungus.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T21:02:49Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">ant dump</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00005803"/>
        <obo:IAO_0000115>An animal structure that is assembled by a spider from silk, that serves as both habitation and a structure to trap prey.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T21:05:22Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">spider web</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000177"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T21:20:12Z</terms:created>
        <rdfs:comment>A process of pollution degradation involving the deliberate use of cultured or modified organisms to remove or neutralize contaminants, typically within controlled systems.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">bioremediation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000177">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_02000178"/>
