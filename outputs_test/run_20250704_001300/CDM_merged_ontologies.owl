        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
