        <obo:IAO_0000115>A host interaction where the smaller of the two members of a symbiosis causes a disease in the larger member</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
