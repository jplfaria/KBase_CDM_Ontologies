        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process which diminishes the functioning of an ecosystem located on land.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.who.int/globalchange/ecosystems/desert/en/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Land_degradation</oboInOwl:hasDbXref>
    </owl:Axiom>
    


