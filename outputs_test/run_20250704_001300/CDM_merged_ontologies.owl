                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000846"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A cloud which 1) has been shaped into detached fibrous filaments, 2) is almost exclusively composed of ice crystals, 3) is located in the high level of the atmosphere (high étage).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Add more PATO qualities once they have been added to PATO.</obo:IAO_0000116>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <oboInOwl:hasAlternativeId>Ci</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym xml:lang="de">(Eis)-Federwolke</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Cirruswolke</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Zirruswolke</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAtmo"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoCloudAtlas"/>
        <rdfs:comment xml:lang="en">When present in aggregates, individual cirrus clouds are organised in patches or narrow bands. When organised in sheets of fibres they can give a silky sheen. When well-illuminated by sunlight (excluding during sunrise and sunset) cirrus clouds appear white or mostly white. Absence of any precipitation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">cirrus cloud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A cloud which 1) has been shaped into detached fibrous filaments, 2) is almost exclusively composed of ice crystals, 3) is located in the high level of the atmosphere (high étage).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://cloudatlas.wmo.int/clouds-genera-cirrus.html"/>
        <oboInOwl:hasDbXref rdf:resource="https://cloudatlas.wmo.int/docs/Excerpt%20from%20wmo_49-1_final_2017.pdf"/>
        <oboInOwl:hasDbXref>https://cloudatlas.wmo.int/clouds-genera.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Cloud</oboInOwl:hasDbXref>
    </owl:Axiom>
    


