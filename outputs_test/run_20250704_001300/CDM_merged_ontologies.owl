    <!-- http://purl.obolibrary.org/obo/FOODON_00001172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001262"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460177"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">The default nut product is a whole, raw nut - meaning that the kernel is whole, and moderately or significantly dried, but not baked.  Minimal references to nuts often leave ambiguous whether the shell is on or off. &quot;I ate a peanut&quot; doesn&apos;t clarify whether I ate a shell-off nut or whether I did the shelling.</obo:IAO_0000116>
        <terms:contributor xml:lang="en">Damion Dooley</terms:contributor>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F16972"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">nut food product</rdfs:label>
    </owl:Class>
    


