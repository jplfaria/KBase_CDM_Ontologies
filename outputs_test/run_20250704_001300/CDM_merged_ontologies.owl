        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000835"/>
        <obo:IAO_0000115>A cloud droplet composed primarily of water.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>cloud drop</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cloud droplet</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>water based cloud droplet</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">water-based cloud droplet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000703"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000727"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasBroadSynonym>A process in which precipitation falls from a cloud but evaporates or sublimes before making contact with a planetary surface.</oboInOwl:hasBroadSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">virga</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000837"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>A process in which precipitation falls from a cloud but evaporates or sublimes before making contact with a planetary surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Rain</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000838 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000838">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010505"/>
