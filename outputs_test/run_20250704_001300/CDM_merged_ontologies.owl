        <owl:annotatedTarget>A process during which microscopic liquid droplets are formed from gaseous materials in an atmosphere.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Particulates</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000020"/>
