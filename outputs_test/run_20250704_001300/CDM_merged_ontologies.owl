        <obo:IAO_0000115>Melting is a material transformation process which results in the phase transition of a substance from a solid to a liquid.</obo:IAO_0000115>
        <obo:IAO_0000116>could replace with http://purl.obolibrary.org/obo/REX_0000177</obo:IAO_0000116>
        <oboInOwl:hasDbXref rdf:resource="http://sweetontology.net/procStateChange/Melting"/>
        <oboInOwl:hasExactSynonym>melting process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fusion</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>Note that melting need not be due to warming, thus the classes are separated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">melting</rdfs:label>
    </owl:Class>
    <owl:Axiom>
