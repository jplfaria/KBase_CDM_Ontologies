            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A haze formation process which has an increased rate relative to that which is usually present in a given site.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">haze formation event</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A haze formation process which has an increased rate relative to that which is usually present in a given site.</owl:annotatedTarget>
