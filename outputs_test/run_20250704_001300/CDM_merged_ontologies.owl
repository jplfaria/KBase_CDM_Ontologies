        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A cryospheric layer which is primarily composed of snow.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0003-4808-4736</oboInOwl:hasDbXref>
