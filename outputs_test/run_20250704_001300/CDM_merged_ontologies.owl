        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">outer planetary core</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000643 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000641"/>
        <rdfs:comment>Needs a general definition that holds for Earth as well as other planets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">inner planetary core</rdfs:label>
