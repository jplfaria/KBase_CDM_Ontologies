            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Weather which inheres in an atmosphere.</obo:IAO_0000115>
        <rdfs:comment>This class refers to the common usage of &quot;weather&quot;, referencing the state of a (part of) an astronomical body&apos;s atmosphere.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">atmospheric weather</rdfs:label>
