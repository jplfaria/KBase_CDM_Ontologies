        <oboInOwl:hasExactSynonym>stomodaeum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mouth pit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oral pit</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>stomodeum</rdfs:label>
    </owl:Class>
    


