        <obo:IAO_0000115>A tectonic earthquake which has two or more mainshocks of similar magnitude, and which originate from the same fracture zone and stress field.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-07T14:30:11Z</dc:date>
        <oboInOwl:hasBroadSynonym>multiplet earthquake</oboInOwl:hasBroadSynonym>
        <rdfs:comment>The mainshocks may be separated by seconds or years. Mainshocks must be within 1.2 units of magnitude of one another and have nearly identical seismic waveforms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">multiplet tectonic earthquake</rdfs:label>
    </owl:Class>
