    <!-- http://purl.obolibrary.org/obo/FOODON_03412344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03412344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411016"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B2344"/>
        <oboInOwl:hasSynonym xml:lang="en">amorphophallus konjac</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">amorphophallus rivieri</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">hydrosme rivieri</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">leopard palm</oboInOwl:hasSynonym>
