        <owl:annotatedTarget>A glacier on a plateau or high area, smaller than an ice sheet.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Tidewater_glacier#Types_of_glaciers</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001307"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002220"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A glacier which 1) flows for all or most of its length within the walls of a valley, in consequence having a distinct tongue and a well-defined outline and 2) descends from either high mountains, from an ice cap on a plateau, or from an ice sheet.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Valley_glacier</oboInOwl:hasDbXref>
        <rdfs:comment>These glaciers typically flow down pre-existing valleys and have ice-free slopes overlooking the glacier surface.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>valley glacier</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A glacier which 1) flows for all or most of its length within the walls of a valley, in consequence having a distinct tongue and a well-defined outline and 2) descends from either high mountains, from an ice cap on a plateau, or from an ice sheet.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Tidewater_glacier#Types_of_glaciers</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0003-4808-4736</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000458"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>These glaciers typically flow down pre-existing valleys and have ice-free slopes overlooking the glacier surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0003-4808-4736</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
        <obo:IAO_0000115>A glacier fed by an ice sheet.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Outlet_glacier</oboInOwl:hasDbXref>
