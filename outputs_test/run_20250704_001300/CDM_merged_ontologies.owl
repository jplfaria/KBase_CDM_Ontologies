    <!-- http://purl.obolibrary.org/obo/PO_0009013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
