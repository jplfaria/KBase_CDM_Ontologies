        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000243"/>
        <obo:IAO_0000115>A palustrine wetland with deep, acidic, sandy, peat soils. Groundwater saturates the soil except during brief seasonal dry spells and during prolonged droughts. Pocosin soils are nutrient deficient (oligotrophic), especially in phosphorus.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>pocasin</rdfs:label>
    </owl:Class>
