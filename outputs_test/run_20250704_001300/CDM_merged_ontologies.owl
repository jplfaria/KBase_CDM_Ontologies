    <!-- http://purl.obolibrary.org/obo/ENVO_03501318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000254"/>
        <obo:IAO_0000115 xml:lang="en">An environmental system which is part of a food production facility and whose boundaries are defined by hygienic requirements.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-5192-7047"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-15T04:00:01.750Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">hygienic zone</oboInOwl:hasBroadSynonym>
        <rdfs:comment xml:lang="en">This class is more a convenience grouping class, but can be axiomatised if a hygienic assessment process is completed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">hygienic food production area</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501318"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An environmental system which is part of a food production facility and whose boundaries are defined by hygienic requirements.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1016/B978-1-78242-447-5.00004-6"/>
    </owl:Axiom>
    


