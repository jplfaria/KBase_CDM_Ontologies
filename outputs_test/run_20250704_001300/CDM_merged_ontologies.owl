        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002465"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organ system subdivision that is a network of vessels capable of removing accumulating protein and fluid from the interstitial space and returning it to the vascular space. In some species, this network is connected to the immune system via lymph nodes and lymphocyte-producing organs, with the whole being the lymphoid system.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>lymphatic system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphatic tree system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lymporeticular system</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>lymphatic part of lymphoid system</rdfs:label>
    </owl:Class>
    


