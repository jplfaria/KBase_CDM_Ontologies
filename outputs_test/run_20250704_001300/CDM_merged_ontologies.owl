        <obo:IAO_0000115>A relationship between a neuron and a region, where the neuron has a functionally relevant number of output synapses in that region.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
