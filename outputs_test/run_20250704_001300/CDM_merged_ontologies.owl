                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A freshwater lake ecosystem which has its functions and composition determined by a large freshwater lake.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-06T14:02:17Z</dc:date>
        <rdfs:comment>The delimitations of &quot;large&quot; lakes are somewhat ambiguous. For details on &quot;Large lakes&quot; (e.g. African rift lakes) see http://worldwildlife.org/biomes/large-lake-ecosystems</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">large freshwater lake ecosystem</rdfs:label>
    </owl:Class>
    


