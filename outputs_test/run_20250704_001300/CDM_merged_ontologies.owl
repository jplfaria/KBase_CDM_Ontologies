    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000298"/>
