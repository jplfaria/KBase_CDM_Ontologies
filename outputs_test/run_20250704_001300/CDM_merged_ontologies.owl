        <obo:IAO_0000115>A human construction which is used to initiate and control a fission nuclear chain reaction or nuclear fusion reactions.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
