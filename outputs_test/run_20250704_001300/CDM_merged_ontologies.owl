        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115>A solid or highly viscous plant or synthetic based substance that is typically convertible into polymers.</obo:IAO_0000115>
