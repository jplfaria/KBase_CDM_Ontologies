                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0015008"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000461"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001997"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0103004"/>
        <obo:IAO_0000115>A total amount which is relatively low.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-10T16:36:36Z</dc:date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0103005</oboInOwl:id>
        <terms1:contributor rdf:resource="https://orcid.org/0000-0001-8314-2140"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pato/pato-base.owl"/>
        <rdfs:label>decreased total amount</rdfs:label>
    </owl:Class>
    


