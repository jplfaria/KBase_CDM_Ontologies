        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Algal_bloom</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_2000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_2000005">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_2000004"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
