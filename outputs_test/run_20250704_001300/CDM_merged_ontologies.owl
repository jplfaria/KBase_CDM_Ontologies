    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000313"/>
        <obo:IAO_0000115 xml:lang="en">An anthropogenic environment which is the product of a particular human occupational acitivity.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-9578-0788"/>
