            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lava flow is a moving outpouring of lava, which is created during a non-explosive effusive eruption.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#environmental_hazards"/>
