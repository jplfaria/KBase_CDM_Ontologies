    <!-- http://purl.obolibrary.org/obo/ENVO_02000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000019"/>
