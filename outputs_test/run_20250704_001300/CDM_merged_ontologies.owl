        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000132"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A glacier which covers an area of greater than 50,000 square kilometers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ice_sheet</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000132"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>This is not always classified as a glacier in the cryosphere community.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://github.com/Vocamp/Virtual-Hackahon-on-Glacier-topic</oboInOwl:hasDbXref>
    </owl:Axiom>
    


