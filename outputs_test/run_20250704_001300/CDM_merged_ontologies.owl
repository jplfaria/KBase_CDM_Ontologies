            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_00001087"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_03316694"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A fat or oil derived from vegetable material</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">vegetable fat or oil added</obo:IAO_0000118>
        <terms:contributor xml:lang="en">Damion Dooley</terms:contributor>
        <oboInOwl:hasDbXref>langual:H0263</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">This is a convenience class inherited from LanguaL</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">vegetable fat or oil</rdfs:label>
    </owl:Class>
    


