    <!-- http://purl.obolibrary.org/obo/ENVO_00000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000147">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000067"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000015"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The region occupied by any more or less continuous, directed movement of ocean water that flows in one of the Earth&apos;s oceans. Ocean Currents are rivers of hot or cold water within the ocean. The currents are generated from the forces acting upon the water like the earth&apos;s rotation, the wind, the temperature and salinity differences and the gravitation of the moon. The depth contours, the shoreline and other movements influence the direction and strength of the movements of water that forms a given current.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>current</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EcoLexicon:ocean_current</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:597</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:598</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:H.CRNT</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>LTER:386</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:OceanCurrent</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ocean_current</oboInOwl:hasDbXref>
        <rdfs:comment>Subclasses of this class are to be populated by inference. Definition modified from http://en.wikipedia.org/wiki/Ocean_current.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>ocean current</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000147"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The region occupied by any more or less continuous, directed movement of ocean water that flows in one of the Earth&apos;s oceans. Ocean Currents are rivers of hot or cold water within the ocean. The currents are generated from the forces acting upon the water like the earth&apos;s rotation, the wind, the temperature and salinity differences and the gravitation of the moon. The depth contours, the shoreline and other movements influence the direction and strength of the movements of water that forms a given current.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BS:bs</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000147"/>
