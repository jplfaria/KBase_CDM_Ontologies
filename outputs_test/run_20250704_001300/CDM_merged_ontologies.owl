    <!-- http://purl.obolibrary.org/obo/ENVO_03000127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000830"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000982"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000358"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A water-based rainfall process during which water droplets with increased acidity fall towards a planetary surface.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>https://orcid.org/0000-0002-3884-3420</obo:IAO_0000117>
        <oboInOwl:hasBroadSynonym>acid rain</oboInOwl:hasBroadSynonym>
        <rdfs:comment>On Earth, the acidity of raindrops is typically increased through interactions of water molecules with sulfur dioxide or nitrogen oxide, released into the atmosphere by natural or anthropogenic processes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">acid rainfall</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A water-based rainfall process during which water droplets with increased acidity fall towards a planetary surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Acid_rain</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000128">
