        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0103001"/>
        <obo:IAO_0000115>A total mass which is higher than normal or average.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-10T16:25:35Z</dc:date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
