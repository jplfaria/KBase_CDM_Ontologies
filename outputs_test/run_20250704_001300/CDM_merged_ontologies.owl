        <owl:annotatedTarget>A bird nest is the spot in which a bird lays and incubates its eggs and raises its young.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Bird_nest</oboInOwl:hasDbXref>
    </owl:Axiom>
    


