            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Future brain vesicle that gives rise to telencephalic ventricle/lateral ventricles and 3rd ventricle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>prosencephalic vesicle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>preevaginated forebrain vesicle</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>forebrain ventricle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>forebrain vesicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prosencephalic ventricle</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
