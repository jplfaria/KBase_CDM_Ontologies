    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000983 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
