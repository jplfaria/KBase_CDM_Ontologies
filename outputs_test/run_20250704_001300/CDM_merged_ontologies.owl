                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003729"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003350"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003929"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003729"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An epithelium that is part of the mouth and lines the oral cavity, typically stratified squamous, and may be para-, ortho- or non- keratinized. Primary barrier between oral environment and deeper tissues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>epithelium of mucosa of mouth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelium of oral mucosa</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>oral epithelium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002443">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
