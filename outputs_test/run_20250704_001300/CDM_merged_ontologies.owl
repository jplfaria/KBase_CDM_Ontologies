        <dc:creator rdf:resource="http://orcid.org/0000-0002-2908-3327"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-01-19T18:28:58Z</dc:date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">electroplating fume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03500017 -->

