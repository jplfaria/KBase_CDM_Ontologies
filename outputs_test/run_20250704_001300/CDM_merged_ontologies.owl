                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000295"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001554"/>
        <obo:IAO_0000115 xml:lang="en">A surface layer which is part of an ocean or sea.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-06T01:22:01Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoMarine"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">At this level, the depth of this layer is ambiguous. Some methods (telemetry) measure only the first few centimeters of the sea or ocean surface. In situ methods often sample the first few meters. Subclasses can be created for such cases.
Sea surface layer is also used to refer to the surfaces of oceans.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">sea surface layer</rdfs:label>
    </owl:Class>
    


