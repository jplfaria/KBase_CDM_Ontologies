    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000104"/>
        <obo:IAO_0000115>Feature on the ocean floor at a depth of 3500 - 6000 meters.</obo:IAO_0000115>
