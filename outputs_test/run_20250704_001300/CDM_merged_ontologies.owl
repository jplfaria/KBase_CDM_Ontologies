            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A long and narrow sheet of ice projecting out from the coastline. An ice tongue forms when a valley glacier moves very rapidly out into the ocean or a lake.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>TGN:21143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ice_tongue</oboInOwl:hasDbXref>
