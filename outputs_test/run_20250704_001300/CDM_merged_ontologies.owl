    <!-- http://purl.obolibrary.org/obo/ENVO_00000289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000176"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
        <obo:IAO_0000115>The raised fault block bounded by normal faults. The raised block is a portion of the Earth&apos;s crust that has remained stationary while the land has sunk on either side of it or has been crushed by a mountain range against it.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>horst</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000289"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
