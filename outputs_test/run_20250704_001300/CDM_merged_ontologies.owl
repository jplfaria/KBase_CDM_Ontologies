    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000426"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ocean basin floor</owl:annotatedTarget>
        <rdfs:comment>When &quot;ocean basin&quot; is used in a hydrological sense, then &quot;ocean basin floor&quot; is any floor under seawater. In ENVO, the class &quot;ocean basin&quot; is used in a geological sense, which does not include all areas of ocean floor.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000426"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
