    <!-- http://purl.obolibrary.org/obo/ENVO_01001109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001479"/>
        <rdfs:subClassOf>
            <owl:Restriction>
