                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000650"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mass wasting flow during which water-laden masses of soil and fragmented rock rush down the slopes of elevations, funnel into stream channels, entrain objects in their paths, and form thick, muddy deposits on valley floors.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#environmental_hazards"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">debris flow</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000698"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass wasting flow during which water-laden masses of soil and fragmented rock rush down the slopes of elevations, funnel into stream channels, entrain objects in their paths, and form thick, muddy deposits on valley floors.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Debris_flow"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000699 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000699">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000697"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
