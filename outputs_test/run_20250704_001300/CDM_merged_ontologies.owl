    <!-- http://purl.obolibrary.org/obo/ENVO_00000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000020"/>
        <obo:IAO_0000115>A lake which has layers of water which do not intermix.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:meromictic_lake_</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">The deepest layer of water in such a lake typically does not contain any dissolved oxygen. The layers of sediment at the bottom of a meromictic lake remain relatively undisturbed because there are no living organisms to stir them up.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>meromictic lake</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000199"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
