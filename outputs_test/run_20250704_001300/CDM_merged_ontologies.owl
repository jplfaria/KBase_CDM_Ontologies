        <rdfs:label>Visualization</rdfs:label>
    </owl:Class>
    


    <!-- https://credit.niso.org/contributor-roles/writing-original-draft -->

    <owl:Class rdf:about="https://credit.niso.org/contributor-roles/writing-original-draft">
