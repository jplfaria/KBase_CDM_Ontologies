                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A material transformation process during which brine is formed due to the expulsion of salt during frazil formation or a seawater freezing process.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>Expelled salt accumulates in brine droplets, which remain in a liquid state due to their increased salinity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">brine rejection from seawater</rdfs:label>
