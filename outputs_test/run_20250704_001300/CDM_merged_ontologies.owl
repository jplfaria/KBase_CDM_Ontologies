                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115>x is transcribed from y if and only if x is synthesized from template y</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
