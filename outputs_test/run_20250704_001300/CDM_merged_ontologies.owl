    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03401270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03401270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400289"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">Food and Drugs, title 21, Code of Federal Regulations. Original food classification in LanguaL.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>langual:A1270</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">U.S. code of federal regulations, title 21 food product type</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.ecfr.gov/cgi-bin/text-idx?SID=87f720ce0d0b6c4548f4bbfd1f8e4c3d&amp;mc=true&amp;tpl=/ecfrbrowse/Title21/21chapterI.tpl</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03411009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411048"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1009"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">polysaccharide-producing plant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03411013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411013">
