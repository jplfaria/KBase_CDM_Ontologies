        <owl:annotatedTarget>Contaminated animal feed is an animal feed that has become contaminated with or come contact with microorganisms or toxic chemicals.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>URL:http://www.cdc.gov/oralhealth/infectioncontrol/glossary.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


