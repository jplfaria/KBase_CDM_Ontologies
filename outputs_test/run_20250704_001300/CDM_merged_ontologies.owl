        <obo:IAO_0000115>A surface layer where the solid or liquid material of an astronomical body comes into contact with an atmosphere or outer space.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-04T16:55:57Z</oboInOwl:creation_date>
        <oboInOwl:hasRelatedSynonym xml:lang="en">land surface</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>a useful class: this can be used to define sub-terrestrial and sub-marine entities</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">surface of an astronomical body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001484 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000755"/>
