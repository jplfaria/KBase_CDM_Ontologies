    <!-- http://purl.obolibrary.org/obo/ENVO_06105119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000043"/>
        <obo:IAO_0000115 xml:lang="en">A material transformation process during which the properties of a material are changed as a result of in situ exposure to atmospheric processes.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T18:39:54Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">Verwitterung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">meteorización</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">meteorizzazione</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="zh">風化(作用)</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">The term &quot;weathering&quot; should not be confused with &quot;erosion&quot;, which is the removal and transport of environmental material away from a site via exogenic processes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">weathering</rdfs:label>
    </owl:Class>
