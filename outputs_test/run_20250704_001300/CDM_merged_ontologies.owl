    <!-- http://purl.obolibrary.org/obo/FOODON_00001288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001153"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Cantaloupe (also known as muskmelon (India and the United States), mushmelon, rockmelon (in Australian states and in New Zealand), sweet melon, spanspek (South Africa), or capuchin (Scotland) refers to a variety of the Cucumis melo species in the Cucurbitaceae family.</obo:IAO_0000115>
        <terms:contributor xml:lang="en">Damion Dooley</terms:contributor>
        <oboInOwl:hasExactSynonym>cantaloup</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>muskmelon</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">cantaloupe fruit food product</rdfs:label>
    </owl:Class>
    


