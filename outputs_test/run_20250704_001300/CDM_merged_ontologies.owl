                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_00001178"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_00002501"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001178"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002501"/>
