    <!-- http://purl.obolibrary.org/obo/PATO_0001392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001377"/>
        <obo:IAO_0000115>A polyploidy quality inhering in a bearer by virtue of the bearer&apos;s chromosome number being increased by endomitosis and for which the degree of ploidy is proportional to the number of times that endomitosis has taken place.</obo:IAO_0000115>
