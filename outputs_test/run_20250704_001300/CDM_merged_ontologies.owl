                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000267"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000637"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
