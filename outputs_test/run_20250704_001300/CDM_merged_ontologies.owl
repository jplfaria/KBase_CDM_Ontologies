        <rdfs:label xml:lang="en">results in fusion of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012009 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012009">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002304"/>
        <obo:IAO_0000115>p is constitutively upstream of q iff p is causally upstream of q, p is required for execution of q or a part of q, and the execution of p is approximately constant.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:01:01Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">constitutively upstream of</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Constitutively_upstream_of</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012010">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002305"/>
        <obo:IAO_0000115>p removes input for q iff p is causally upstream of q, there exists some c such that p has_input c and q has_input c, p reduces the levels of c, and c is rate limiting for execution of q.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:06:20Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">removes input for</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Removes_input_for</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012011 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012011">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
        <obo:IAO_0000115>p is indirectly causally upstream of q iff p is causally upstream of q and there exists some process r such that p is causally upstream of r and r is causally upstream of q.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:07:17Z</oboInOwl:creation_date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">indirectly causally upstream of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012012 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012012">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0012011"/>
        <obo:IAO_0000115>p indirectly regulates q iff p is indirectly causally upstream of q and p regulates q.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:08:01Z</oboInOwl:creation_date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">indirectly regulates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012013 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012013">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <obo:IAO_0000115>x &apos;positively regulates in other organism&apos; y if and only if: (x is the realization of a function to increase the frequency, rate or extent of y) AND (the agents of x are produced by organism o1 and the agents of y are produced by organism o2).</obo:IAO_0000115>
        <obo:RO_0004049 rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T10:02:28Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>positively regulates in other organism</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">positively regulates in another organism</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012014 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012014">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <obo:IAO_0000115>x &apos;negatively regulates in other organism&apos; y if and only if: (x is the realization of a function to reduce the frequency, rate or extent of y) AND (the agents of x are produced by organism o1 and the agents of y are produced by organism o2).</obo:IAO_0000115>
        <obo:RO_0004050 rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T10:02:42Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>negatively regulates in other organism</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label xml:lang="en">negatively regulates in another organism</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0013001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0013001">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002130"/>
