        <oboInOwl:id>PATO:0070017</oboInOwl:id>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pato/pato-base.owl"/>
        <rdfs:label>standard pyramidal morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0070017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pyramidal family morphology that inheres in neurons which have a standard pyramidal shape with its apical dendrite aligned vertically.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi:10.1016/b978-0-12-369497-3.10004-4</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0070018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0070017"/>
        <obo:IAO_0000115>A pyramidal cell morphology that inheres in neurons which have a distinct tuft formation, distal from the soma.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasDbXref>ilxtr:TuftedPyramidalPhenotype</oboInOwl:hasDbXref>
