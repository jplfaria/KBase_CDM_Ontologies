        <oboInOwl:hasDbXref>URL:http://www.merriam-webster.com/dictionary/feedlot</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000155"/>
