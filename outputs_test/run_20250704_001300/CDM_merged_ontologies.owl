        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Ceramic"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03501309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
