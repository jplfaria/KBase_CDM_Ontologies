    <!-- http://purl.obolibrary.org/obo/ENVO_06105002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000115 xml:lang="en">A disposition inhering in a bearer by virtue of that bearer&apos;s ability to, repeatedly, become plastic on heating and harden again on cooling.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-27T09:10:14Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="it">termoplasticità</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="zh">熱塑性</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">thermoplasticity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
