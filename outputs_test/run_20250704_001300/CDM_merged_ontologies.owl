                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An alpine tundra ecosystem which exists above the continuous timberline but below the permanent snowline on elevated land in tropical regions.</obo:IAO_0000115>
        <rdfs:comment>Paramo ecosystems are known to be evolutionary hotspots and large daily fluctuations in temperature and humidity, often resulting in dialy freez-thaw cycles.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">Paramo</rdfs:label>
    </owl:Class>
