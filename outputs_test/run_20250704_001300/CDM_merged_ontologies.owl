        <obo:IAO_0000115>The surface layer of a mass of sediment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>surface of a sedimentary mass</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surface sediment</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">sediment surface</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001193 -->

