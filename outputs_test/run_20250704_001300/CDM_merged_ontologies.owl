                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A conflagration which is uncontrolled and combusts material in a vegetated area, be it rural or wild.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>wildland fire</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#environmental_hazards"/>
        <rdfs:comment>The definition of &quot;wildland&quot; or &quot;wild&quot; is ambiguous.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">wildfire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000788 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000788">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000786"/>
        <obo:IAO_0000115>A fire which occurs in a large spatial area poses a risk to human life, animal life, health, and/or property.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>blaze</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>large fire</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">conflagration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000788"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A fire which occurs in a large spatial area poses a risk to human life, animal life, health, and/or property.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Conflagration</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000789 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000797"/>
