            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">tables section</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The section labelled &apos;tables&apos; in a typical scientific journal article.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A part of a document that contains one or more tables.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON: Bill Baumgartner</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">tables</obo:IAO_0000118>
