        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plain that originally formed in a lacustrine environment, that is, as the bed of a lake, but from which the water has disappeared, by natural drainage, evaporation or other geophysical processes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Lacustrine_plain</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000106"/>
        <obo:IAO_0000115>An area of land of low topographic relief that historically supported grasses and herbs, with few trees, and having generally a mesic (moderate or temperate) climate. Dominated by tall grasses (contrast steppe).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FTT:259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:707</oboInOwl:hasDbXref>
