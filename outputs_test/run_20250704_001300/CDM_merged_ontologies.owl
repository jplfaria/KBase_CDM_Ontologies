        <obo:IAO_0000115>A dry stream channel through which a river had flowed, but now contains no appreciable accumulations of water.</obo:IAO_0000115>
        <rdfs:comment>See http://purl.obolibrary.org/obo/ENVO_01000979 for the channel of an intermittent river.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">dry river</rdfs:label>
    </owl:Class>
