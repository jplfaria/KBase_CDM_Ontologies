    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000258"/>
        <obo:IAO_0000115>A cline across which the density of a fluid changes rapidly.</obo:IAO_0000115>
