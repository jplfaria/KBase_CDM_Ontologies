    <!-- http://purl.obolibrary.org/obo/ENVO_01000593 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000587"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000590"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000591"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000592"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A framed bed is a piece of furniture which is composed of a mattress supported by a bed base and held in place by a bed frame.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">framed bed</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A framed bed is a piece of furniture which is composed of a mattress supported by a bed base and held in place by a bed frame.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Bed</oboInOwl:hasDbXref>
