        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001562"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0103001"/>
        <obo:IAO_0000115>A total mass which is lower than normal or average.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-10T16:29:00Z</dc:date>
