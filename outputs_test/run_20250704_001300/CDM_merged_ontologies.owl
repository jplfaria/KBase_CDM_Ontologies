        <rdfs:comment xml:lang="en">A form of disordered mechanical energy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>thermal energy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_2000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_2000033">
