        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001170"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planned process during which human agents establish plant communities in ecosystems which have previously been, partially or wholly, stripped of existing plant communities.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>planned revegetation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02500033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02500033">
