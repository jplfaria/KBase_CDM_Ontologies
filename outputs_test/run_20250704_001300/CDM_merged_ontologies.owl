            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Sediment characterised by an average particle diameter between 1 and 3.9 micrometers.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-17T01:58:08Z</oboInOwl:creation_date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>clay sediment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000120"/>
