    <!-- http://purl.obolibrary.org/obo/ENVO_01001152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000800"/>
        <obo:IAO_0000115>A planet which is smaller than Mercury but larger than Ceres.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAstro"/>
