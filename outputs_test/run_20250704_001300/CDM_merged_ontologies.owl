        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">50220000 - cereal/grain/pulse products (gs1 gpc)</rdfs:label>
    </owl:Class>
    


