    <!-- http://purl.obolibrary.org/obo/ENVO_01001953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001949"/>
