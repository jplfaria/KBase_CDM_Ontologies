        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A coast is the area where land meets the sea, ocean, or lake.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Coast</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000687"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
