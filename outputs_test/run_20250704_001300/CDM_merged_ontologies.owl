            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A crater which is found in permafrost and formed as a result of an explosion fuelled by methane formerly contained in that permafrost.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:hasBroadSynonym>gigantic funnel</oboInOwl:hasBroadSynonym>
