    <!-- http://purl.obolibrary.org/obo/ENVO_03501312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03501312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501311"/>
