                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Compressed natural gas is a natural gas stored at high pressures, typically 20–25 Megapascals.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">compressed natural gas</rdfs:label>
    </owl:Class>
