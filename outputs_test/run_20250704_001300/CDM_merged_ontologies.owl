                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An accumulation process during which a powdery snow carried on the wind settles on a solid surface, forming a mound.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
