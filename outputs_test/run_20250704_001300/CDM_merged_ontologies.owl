    <!-- http://purl.obolibrary.org/obo/PATO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001301"/>
        <obo:IAO_0000115>A scalar chromatic property that is the degree of purity of perceived light.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0000017</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <rdfs:comment>Color saturation refers to the amount of white light or gray paint mixed in with the hue (single wavelength) and is a measure of color purity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pato/pato-base.owl"/>
        <rdfs:label>color saturation</rdfs:label>
