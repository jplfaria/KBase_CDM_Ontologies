        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001950"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001951"/>
        <obo:IAO_0000115>A tropical rainforest which is in its climactic successional state.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-09T18:00:40Z</dc:date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
