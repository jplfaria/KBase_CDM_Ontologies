        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003861"/>
        <obo:IAO_0000115 xml:lang="en">An industrial building made from steel and covered in polyethylene used for plant cultivation.</obo:IAO_0000115>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-15T04:00:01.750Z</oboInOwl:creation_date>
