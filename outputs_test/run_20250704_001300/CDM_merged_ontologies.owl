            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An island formed of trees and shrubs that grow in saline coastal habitats in the tropics and subtropics.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FTT:147</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:891</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:T.ISLM</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>mangrove island</rdfs:label>
    </owl:Class>
