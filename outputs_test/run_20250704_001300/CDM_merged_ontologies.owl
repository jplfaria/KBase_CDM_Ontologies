        <obo:IAO_0000115>An ice cap climatic condition is a polar condition in which the montly average temperature does not exceed 0 degrees Celsius.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>ice cap climatic condition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
