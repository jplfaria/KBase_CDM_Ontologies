        <oboInOwl:hasDbXref rdf:resource="https://www.lexico.com/definition/entangle"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105121">
