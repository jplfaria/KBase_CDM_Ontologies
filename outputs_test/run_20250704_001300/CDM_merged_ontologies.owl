            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Subdivision of skeleton which which consists of all the skeletal elements in in the pectoral and pelvic appendage complexes[cjm].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>appendicular skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>entire appendicular skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>paired fin skeleton</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>skeleton appendiculare</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>appendicular skeleton</rdfs:label>
    </owl:Class>
    


