    <!-- http://purl.obolibrary.org/obo/ENVO_01000637 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115>Outer space is a hard vacuum containing a low density of particles, predominantly a plasma of hydrogen and helium as well as electromagnetic radiation, magnetic fields, neutrinos, dust and cosmic rays that exists between celestial bodies.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>space</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAstro"/>
