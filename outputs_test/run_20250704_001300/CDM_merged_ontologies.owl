        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000171"/>
        <obo:IAO_0000115>An animal habitation assembled by organisms within the clade Hymenoptera. Examples include termite nests, beehives, and ant nests. Typically constructed to serve as habitation for a whole colony ruled by a queen.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T20:07:57Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">hymenopteran habitation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An animal habitation assembled by organisms within the clade Hymenoptera. Examples include termite nests, beehives, and ant nests. Typically constructed to serve as habitation for a whole colony ruled by a queen.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Nest</oboInOwl:hasDbXref>
