        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The planting of trees in areas in where forests have previously been cleared.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Adapted from GEMET:http://www.eionet.europa.eu/gemet/concept/6979</oboInOwl:hasDbXref>
    </owl:Axiom>
    


