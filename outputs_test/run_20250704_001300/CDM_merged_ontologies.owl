    <!-- http://purl.obolibrary.org/obo/PO_0025385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025161"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025387"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of plant substance (PO:0025161) that is the inner layer of a plant cuticle (PO:0000022), and is composed of a polyester matrix of hydroxy- and hydroxy epoxy fatty acid C16 and C18 chains.</obo:IAO_0000115>
        <oboInOwl:created_by>Laurel_Cooper</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-01-06T02:53:37Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>cutin matrix (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>PO_GIT:416</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>クチン (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0025385</oboInOwl:id>
        <rdfs:comment>Cutin is the insoluble, covalently cross-linked polymer that forms an electron dense layer over the epidermal cells (PO:0004013) of an aerial plant structure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>cutin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
