                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A piece of rock which is between two and 64 millimetres in length along its largest dimension.</obo:IAO_0000115>
