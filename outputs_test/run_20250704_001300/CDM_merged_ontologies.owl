    <!-- http://purl.obolibrary.org/obo/ENVO_00000542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000176"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
