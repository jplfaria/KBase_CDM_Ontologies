        <obo:IAO_0000115>Acidification of an aquatic environment is a process whereby the pH of an aquatic environment, biome, or water body is lowered.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">acidification of an aquatic environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000630"/>
        <rdfs:subClassOf>
            <owl:Class>
