        <oboInOwl:hasDbXref>https://github.com/EnvironmentOntology/envo/issues/604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ipcc.ch/ipccreports/tar/wg1/040.htm</oboInOwl:hasDbXref>
