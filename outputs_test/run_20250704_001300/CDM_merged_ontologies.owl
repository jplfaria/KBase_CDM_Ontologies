        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03520002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">A part of the troposphere which extends from 3 km to 8 km (10 000 – 25 000 ft) height in the polar region, from 5 km to 13 km (16 500 – 45 000 ft) height in the temperate region, and from 6 km to 18 km (20 000 – 60 000 ft) height in the tropical region.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://cloudatlas.wmo.int/en/useful-concepts.html#levels"/>
    </owl:Axiom>
    


