    <!-- http://purl.obolibrary.org/obo/ENVO_01000528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000516"/>
        <obo:IAO_0000115>A toilet fixture which uses little to no water; excreta is removed manually or composted in situ.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:hasBroadSynonym>dry toilet</oboInOwl:hasBroadSynonym>
