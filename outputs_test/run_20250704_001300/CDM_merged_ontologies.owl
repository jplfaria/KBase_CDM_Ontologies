        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
        <obo:IAO_0000115>An emergent molecular quality that arises by virtue of the bearer&apos;s disposition to exhibit molecular attraction to another entity in contact.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>adhesiveness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>stickiness</oboInOwl:hasRelatedSynonym>
