        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mattress is a mass of material which is able to cushion and support a reclining body and is used as or on a bed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Mattress</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000587"/>
        <obo:IAO_0000115>A bed frame is a piece of furniture which is used to position a mattress and bed base and may include a means of supporting a canopy.</obo:IAO_0000115>
