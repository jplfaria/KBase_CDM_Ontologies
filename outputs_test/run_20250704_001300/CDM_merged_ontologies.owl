                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000655"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Tephra is fragmental material produced by a volcanic eruption regardless of composition, fragment size or emplacement mechanism.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">tephra</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tephra is fragmental material produced by a volcanic eruption regardless of composition, fragment size or emplacement mechanism.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Tephra</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000661 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00001995"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
