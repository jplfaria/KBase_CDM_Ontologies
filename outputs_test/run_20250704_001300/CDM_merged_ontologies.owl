            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A presumptive structure that has the potential to develop into a forebrain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>future prosencephalon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>presumptive forebrain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>presumptive prosencephalon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>prosencephalon</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>future forebrain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007651"/>
