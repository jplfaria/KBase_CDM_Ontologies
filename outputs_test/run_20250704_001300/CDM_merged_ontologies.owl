    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000840"/>
