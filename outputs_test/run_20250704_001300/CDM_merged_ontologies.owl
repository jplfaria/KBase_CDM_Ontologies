        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Pocosin</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000240">
