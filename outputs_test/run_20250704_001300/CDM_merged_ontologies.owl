        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">muskmelon (Cucumis melo) fruit food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001152"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Citrullus lanatus is a plant species in the family Cucurbitaceae, a vine-like (scrambler and trailer) flowering plant originally from sub-Saharan Africa. It is cultivated for its fruit. The subdivision of this species into two varieties, watermelons (Citrullus lanatus (Thunb.) var. lanatus) and citron melons (Citrullus lanatus var. citroides (L. H. Bailey) Mansf.)</obo:IAO_0000115>
        <terms:contributor xml:lang="en">Damion Dooley</terms:contributor>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">citrullus lanatus fruit food product</rdfs:label>
    </owl:Class>
    


