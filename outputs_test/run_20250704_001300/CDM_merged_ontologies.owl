    <!-- http://purl.obolibrary.org/obo/ENVO_01001402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001089"/>
