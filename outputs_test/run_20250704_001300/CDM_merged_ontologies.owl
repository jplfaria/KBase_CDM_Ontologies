                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000779"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A road which is publically accessible.</obo:IAO_0000115>
        <obo:IAO_0000116>This class is created for the SDGIO and the &apos;public infrastructure&apos; class. The publically accessible attribute could be axiomatised.</obo:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">public road</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000781 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000779"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A building which is publically accessible.</obo:IAO_0000115>
        <obo:IAO_0000116>Created for SDGIO, we treat &quot;public&quot; as &quot;publically accessible&quot; where the semantics of access are dealt with in SDGIO.</obo:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">public building</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
