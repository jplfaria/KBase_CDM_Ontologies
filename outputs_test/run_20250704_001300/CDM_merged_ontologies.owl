    <!-- http://purl.obolibrary.org/obo/ENVO_02000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000006"/>
        <obo:IAO_0000115>A termite nest that is built above ground in trees or on structures, often resembling large lumps attached to branches.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T20:09:37Z</terms:created>
