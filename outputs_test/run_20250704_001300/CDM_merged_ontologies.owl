        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000555"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Compressed natural gas is a natural gas stored at high pressures, typically 20–25 Megapascals.</owl:annotatedTarget>
