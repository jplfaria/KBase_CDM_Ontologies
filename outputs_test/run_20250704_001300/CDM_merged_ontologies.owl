        <oboInOwl:id>PATO:0045090</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pato/pato-base.owl"/>
        <rdfs:label>cardinal direction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0045090"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The four cardinal directions or cardinal points are the directions north, east, south, and west, commonly denoted by their initials, N, E, S, W. East and west are at right angles to north and south, with east being in the clockwise direction of rotation from north and west being directly opposite east.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:http://en.wikipedia.org/wiki/Cardinal_direction</oboInOwl:hasDbXref>
    </owl:Axiom>
    


