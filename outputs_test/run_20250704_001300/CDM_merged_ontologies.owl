        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A shape quality inhering in a bearer by virtue of the bearer&apos;s being shaped like a lance-head, considerably longer than wide, tapering towards the tip from below the middle; attached at the broad end.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


