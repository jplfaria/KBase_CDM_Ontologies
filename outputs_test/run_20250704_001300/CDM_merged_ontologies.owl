        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of some aspect of that bearer beginning from a position on another entity.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-05-24T04:10:53Z</dc:date>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
