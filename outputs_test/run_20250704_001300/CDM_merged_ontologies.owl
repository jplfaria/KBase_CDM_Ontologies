                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Flat or concave peatlands with a string-like pattern of hummocks (hence the name), found principally in northern Scandinavia but occurring in the western parts of the former USSR and in North America. A few examples exist in northern Britain.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>wetland</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/String_bog</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>string bog</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>string mire</rdfs:label>
    </owl:Class>
    <owl:Axiom>
