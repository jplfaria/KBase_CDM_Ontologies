        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000067"/>
        <obo:IAO_0000115>A cave formed by the dissolution of soluble rock or other solid material such as limestone, chalk, dolomite, gypsum, salt or marble.</obo:IAO_0000115>
