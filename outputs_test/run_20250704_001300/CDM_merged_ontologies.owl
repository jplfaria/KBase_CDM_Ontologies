    <!-- http://purl.obolibrary.org/obo/IAO_0000632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000300"/>
        <obo:IAO_0000111 xml:lang="en">study limitations textual entity</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Excerpt from the Limitations section of Fermann et al 2015, Acad Emerg Med. 2015 Mar; 22(3): 299–307 (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4405051/). 

Owing to the nature of a post hoc study, any significant values must be interpreted with caution. In the current analysis, no multiple testing was conducted and p-values remain unadjusted. Moreover, a selection bias arising from the randomized open-label design of the original EINSTEIN PE study cannot be ruled out.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A textual entity addressing a shortcoming or bias of a study design or execution.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON: Bill Baumgartner</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">Author guidelines published by The Society for Academic Emergency Medicine. (http://onlinelibrary.wiley.com/journal/10.1111/(ISSN)1553-2712/homepage/ForAuthors.html)</obo:IAO_0000119>
        <obo:IAO_0000233 rdf:resource="https://github.com/information-artifact-ontology/IAO/issues/183"/>
