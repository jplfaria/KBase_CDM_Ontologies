            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Tuff is a type of rock made of volcanic ash ejected from a vent during a volcanic eruption.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">tuff</rdfs:label>
    </owl:Class>
    <owl:Axiom>
