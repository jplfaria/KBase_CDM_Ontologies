    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000980"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A channel through which a directional flow of water periodically occurs, ceasing when bed seepage or evapotranspiration exceed the available water supply.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://encyclopedia2.thefreedictionary.com/Intermittent+stream</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000981 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001747"/>
