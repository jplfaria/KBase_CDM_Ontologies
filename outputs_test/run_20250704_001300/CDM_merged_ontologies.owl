    <!-- http://purl.obolibrary.org/obo/UBERON_0006003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000064"/>
