                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An aerosol that is suspended in an atmosphere.</obo:IAO_0000115>
