    <!-- http://purl.obolibrary.org/obo/ENVO_01000261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000261">
        <obo:IAO_0000115>A cline within a marine water body where the rate of calcite dissolution changes rapidly with depth. The increase in the rate of calcite dissolution with depth is largely due to the concomitant fall in calcite saturation.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="ENVO:01000079"/>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
