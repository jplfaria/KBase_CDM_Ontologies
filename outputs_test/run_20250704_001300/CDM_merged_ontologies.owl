        <oboInOwl:hasDbXref>http://sweetontology.net/realmCryo/IceField</oboInOwl:hasDbXref>
        <rdfs:comment>The floes in a sea ice field must be greater than 10 km across, at least at one location in the field.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">sea ice field</rdfs:label>
    </owl:Class>
    <owl:Axiom>
