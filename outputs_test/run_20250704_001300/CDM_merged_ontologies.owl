        <oboInOwl:hasDbXref rdf:resource="https://glossary.ametsoc.org/wiki/Hailstorm"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000881">
