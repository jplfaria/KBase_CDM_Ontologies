            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any part or collection of parts of the central or peripheral nervous system. Parts may span both CNS and PNS.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>part of nervous system</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>regional part of nervous system</rdfs:label>
    </owl:Class>
    


