        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001548"/>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000723"/>
                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001611"/>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:intersectionOf>
                                    </owl:Class>
