            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The embryonic precursor of the brain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>brain rudiment</oboInOwl:hasExactSynonym>
