        <oboInOwl:hasDbXref>http://sweetontology.net/realmCryo/DriftIce</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">drifting sea ice mass</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A drift ice mass which is composed primarily of sea ice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0003-4808-4736</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001518"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>drift ice</owl:annotatedTarget>
        <rdfs:comment>Researchers of sea ice typically refer to this class simply as &quot;drift ice&quot;.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000813"/>
