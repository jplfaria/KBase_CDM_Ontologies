        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001069"/>
        <obo:IAO_0000115>A metallic material which is composed of two or more metals and used to create a permanent bond between metal workpieces.</obo:IAO_0000115>
