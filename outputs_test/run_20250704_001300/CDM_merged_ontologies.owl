        <rdfs:label xml:lang="en">plant used for producing extract or concentrate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03411016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411016">
