        <obo:IAO_0000115>third planet from the Sun in the Solar System</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">Earth</rdfs:label>
