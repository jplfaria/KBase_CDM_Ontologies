                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000017"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A particle which 1) is composed primarily of and derived from rock or mineral sources and 2) is or was part of a portion of sand.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">grain of sand</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">granule of sand</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sand granule</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">In general, sand grains are larger than those of silt, but finer than those of gravel.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">particle of sand</rdfs:label>
    </owl:Class>
