        <oboInOwl:hasExactSynonym>eye choroid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior uvea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>chorioid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>choroidea</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>optic choroid</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
