            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A forest ecosystem which is dominated by trees adapted to dry or arid environmental conditions.</obo:IAO_0000115>
        <rdfs:comment>A class created to group GFM 2000 terms by the dominant vegetation type. Definitions pending.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>sclerophyllous forest</rdfs:label>
    </owl:Class>
    


