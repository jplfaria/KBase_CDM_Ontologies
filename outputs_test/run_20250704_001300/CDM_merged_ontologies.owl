            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A wetland ecosystem in which soil is saturated with saline water.</obo:IAO_0000115>
        <obo:IAO_0000116>It would be more correct to say that this has_quality salty or has_part ((soil and water) and has_increased_levels_of salt.</obo:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>saline wetland</rdfs:label>
    </owl:Class>
    


