    <!-- http://purl.obolibrary.org/obo/ENVO_00000410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000176"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001884"/>
        <obo:IAO_0000115>An elevated area such as a hill, ridge or old lava dome inside or downslope from an area of active volcanism. New lava flows will cover the surrounding land, isolating the kipuka so that it appears as a (usually) forested island in a barren lava flow.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Kipuka</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
