                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000635"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A material transport process during which a geological surface shifts downward relative to a datum such as sea-level.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>subsidence</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#environmental_hazards"/>
