        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-8844-9165</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000155"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
