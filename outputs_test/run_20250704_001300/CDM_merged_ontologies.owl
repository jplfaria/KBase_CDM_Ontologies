        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>spit</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Geonames:feature</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000307 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001547"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
