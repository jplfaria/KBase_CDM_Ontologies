    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A termite nest that is built above ground, and is made of soil, saliva, and feces, formed as a large mound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Nest</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000006"/>
        <obo:IAO_0000115>A termite nest that is underground, often connected to food sources through a network of tunnels.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
