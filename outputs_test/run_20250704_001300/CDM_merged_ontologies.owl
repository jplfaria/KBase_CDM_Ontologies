    <!-- http://purl.obolibrary.org/obo/ENVO_01000850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000845"/>
        <obo:IAO_0000115>A material which is primarily composed of a substance arranged as a lattice which can trap or contain other molecules.</obo:IAO_0000115>
        <obo:IAO_0000116>Not sure if this should be a subclass of crystal. If it is removed, remember to assert that it is a solid.</obo:IAO_0000116>
        <oboInOwl:hasExactSynonym>clathrate compound material</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>clathrate crystal material</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>This class is not to be confused with CHEBI&apos;s &quot;clathrate&quot;. The latter refers to the pure substance, while this class refers to clathrates found in nature.
&quot;Traditionally, clathrate compounds are polymeric and completely envelop the guest molecule, but in modern usage clathrates also include host-guest complexes and inclusion compounds.&quot; https://en.wikipedia.org/wiki/Clathrate_compound</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">clathrate material</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A material which is primarily composed of a substance arranged as a lattice which can trap or contain other molecules.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Clathrate_compound</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000851 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000850"/>
        <obo:IAO_0000115>A clathrate material in which a large amount of methane is trapped within a crystal structure of water, forming a solid similar to ice.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>fire ice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gas hydrate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hydromethane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>methane hydrate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>methane ice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>natural gas hydrate</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">methane clathrate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000851"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clathrate material in which a large amount of methane is trapped within a crystal structure of water, forming a solid similar to ice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Methane_clathrate</oboInOwl:hasDbXref>
    </owl:Axiom>
    


