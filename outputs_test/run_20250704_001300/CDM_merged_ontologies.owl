    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001093"/>
