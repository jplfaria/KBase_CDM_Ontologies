    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000177"/>
        <obo:IAO_0000115>A till covered area with irregular topography and no ridges, often forming gently rolling hills or plains. Forms by the accumulation of till under the ice by lodgement, but may also be deposited as the glacier retreats.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:ground_moraine</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Ground_moraine</oboInOwl:hasDbXref>
