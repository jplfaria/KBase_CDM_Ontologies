                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Evapotranspiration is the sum of evaporation and plant transpiration from the Earth&apos;s land and ocean surface to the atmosphere.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>evapotranspiration</rdfs:label>
    </owl:Class>
