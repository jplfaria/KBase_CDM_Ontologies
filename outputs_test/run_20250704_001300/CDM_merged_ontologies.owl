    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001389"/>
        <obo:IAO_0000115>A trisomy quality inhering in a bearer when part of the bearer&apos;s extra chromosome is attached to one of the other chromosomes, or if one of the bearer&apos;s chromosomes has two copies of part of its chromosome.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0001390</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
