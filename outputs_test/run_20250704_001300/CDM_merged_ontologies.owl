        <oboInOwl:hasDbXref>FTT:926</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21605</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Prairie</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>grassland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>llanos</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pampa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veld</oboInOwl:hasRelatedSynonym>
