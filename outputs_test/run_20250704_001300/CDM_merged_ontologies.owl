            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An elevation which is formed as an ice mass forms under soil, resulting in upwards deformation of the land surface.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
