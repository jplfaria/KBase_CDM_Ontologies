        <oboInOwl:hasDbXref rdf:resource="https://www.lexico.com/en/definition/thermoplastic"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/thermoplastic"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115 xml:lang="en">An environmental material which is capable of, repeatedly, becoming plastic when heated and hardening again when cooled.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-27T09:45:29Z</dc:date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">thermoplastic material</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An environmental material which is capable of, repeatedly, becoming plastic when heated and hardening again when cooled.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Thermoplastic"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.lexico.com/en/definition/thermoplastic"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000115 xml:lang="en">A disposition which inheres in materials capable of becoming rigid when cured by heating.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-27T13:46:52Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="zh">熱固性</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset xml:lang="zh">envoPlastics</oboInOwl:inSubset>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">thermosetting disposition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A disposition which inheres in materials capable of becoming rigid when cured by heating.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Thermosetting_polymer"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60027"/>
        <obo:IAO_0000115 xml:lang="en">A polymer which has been irreversibly hardened by heat-induced curing.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-27T13:51:32Z</dc:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">thermoset material</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">thermoset</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">thermoset plastic</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">Prior to curing, thermoset materials often occur as a soft solid or viscous liquid prepolymer or resin. In the literature, those are often referred to thermosetting resins.
During curing process, well-defined and irreversible chemical networks form in three dimensions thus giving the thermosets a strong and rigid structure that can be added to other materials to increase strength.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">thermoset polymer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A polymer which has been irreversibly hardened by heat-induced curing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Thermosetting_polymer"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">Prior to curing, thermoset materials often occur as a soft solid or viscous liquid prepolymer or resin. In the literature, those are often referred to thermosetting resins.
During curing process, well-defined and irreversible chemical networks form in three dimensions thus giving the thermosets a strong and rigid structure that can be added to other materials to increase strength.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1016/B978-0-12-816808-0.00001-9"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000776"/>
        <obo:IAO_0000115 xml:lang="en">A piece of plastic which has a matrix- or sponge-like structure with numerous, hollow internal spaces.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-04T13:42:05Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">Plastikschaumstück</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="de">Schaumstoffstück</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">Depending on the type of plastic used and the organisation of the foam, a piece of plastic foam can show elastic properties (even if the plastic it is made out of does not have elastic properties).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">piece of plastic foam</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A piece of plastic which has a matrix- or sponge-like structure with numerous, hollow internal spaces.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1016/B978-185617431-2/50011-6"/>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1533/9780857093967.2.309"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000776"/>
        <obo:IAO_0000115 xml:lang="en">A piece of plastic which is flexible, thin, and planar.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-04T13:58:27Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">Plastikfolie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">pellicola di plastica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">película de plástico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="de">Kunststofffolie</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">plastic membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">plastic sheet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">The edge can be either smooth or angular.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">plastic film</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A piece of plastic which is flexible, thin, and planar.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://www.gesamp.org/publications/guidelines-for-the-monitoring-and-assessment-of-plastic-litter-in-the-ocean"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="en">The edge can be either smooth or angular.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://www.gesamp.org/publications/guidelines-for-the-monitoring-and-assessment-of-plastic-litter-in-the-ocean"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000776"/>
        <obo:IAO_0000115 xml:lang="en">A piece of plastic which 1) is hard, 2) has an irregular shape, and 3) has broken off of a larger piece of plastic.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-04T14:37:37Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="de">Plastikfragment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">fragmento de plástico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">frammento di plastica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plastic flake</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plastic granule</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPlastics"/>
        <rdfs:comment xml:lang="en">To avoid ambiguity, we are being stricter with the &quot;has broken off of a larger piece of plastic&quot; aspect compared to the GESAMP report, which originally stated &quot;having appearance of being broken down from a larger piece of litter&quot;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">plastic fragment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A piece of plastic which 1) is hard, 2) has an irregular shape, and 3) has broken off of a larger piece of plastic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://www.gesamp.org/publications/guidelines-for-the-monitoring-and-assessment-of-plastic-litter-in-the-ocean"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_06105009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_06105009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000776"/>
        <obo:IAO_0000115 xml:lang="en">A piece of plastic which is linear and flexible.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-2996-719X"/>
