        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">seafloor</owl:annotatedTarget>
        <rdfs:comment xml:lang="en">Seas are smaller than oceans and are usually located where the land and ocean meet. However, these two terms are often used interchangeably.</rdfs:comment>
    </owl:Axiom>
    


