        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">introduction to a publication about an investigation</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Section labelled &apos;introduction&apos; of a typical scientific journal article</obo:IAO_0000112>
