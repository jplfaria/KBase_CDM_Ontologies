    <!-- http://purl.obolibrary.org/obo/ENVO_01000535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000517"/>
        <obo:IAO_0000115>A pit latrine which includes a water seal (U-trap or siphon) used over one or two offset pits instead of a plain hole or seat. Water is manually poured through the trap to flush excreta into the latrine pit.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:hasBroadSynonym>toilet</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasRelatedSynonym>bog</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dunny</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>head</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>pour-flush pit latrine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000535"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pit latrine which includes a water seal (U-trap or siphon) used over one or two offset pits instead of a plain hole or seat. Water is manually poured through the trap to flush excreta into the latrine pit.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Pit_latrine</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000536">
