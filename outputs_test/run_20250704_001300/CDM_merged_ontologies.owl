        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A material accumulation process during which the mass of snow on a surface increases.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
    </owl:Axiom>
    


