    <!-- http://purl.obolibrary.org/obo/ENVO_00000287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001491"/>
        <obo:IAO_0000115>An isolated hill with steep sides and a small flat top, smaller than mesas and plateaus. Buttes are formed by erosion when a cap of hard rock, usually of volcanic origin, covers a layer of softer rock that is easily worn away. This hard rock avoids erosion while the rock around it wears down.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>plateau</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FTT:376</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:T.BUTE</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Butte</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21443</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Butte</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605014"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>butte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An isolated hill with steep sides and a small flat top, smaller than mesas and plateaus. Buttes are formed by erosion when a cap of hard rock, usually of volcanic origin, covers a layer of softer rock that is easily worn away. This hard rock avoids erosion while the rock around it wears down.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ADL:FTT</oboInOwl:hasDbXref>
