            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The head is the anterior-most division of the body [GO].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>head (volume)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>adult head</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>cephalic area</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>head</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
        <obo:IAO_0000115>An eye with one concave chamber. Note that &apos;simple&apos; does not imply a reduced level of complexity or acuity.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>simple eye</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004111"/>
        <obo:IAO_0000115>A tubular structure that contains, conveys body fluid, such as blood or lymph.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>vessel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004923"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Organ component adjacent to an organ cavity and which consists of a maximal aggregate of organ component layers.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>wall</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>wall of organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>organ wall</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>anatomical wall</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000465"/>
        <obo:IAO_0000115>Material anatomical entity that is a single connected structure with inherent 3D shape generated by coordinated expression of the organism&apos;s own genome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>biological structure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>connected biological structure</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>anatomical structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Anatomical structure that performs a specific function or group of functions [WP].</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>anatomical unit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>body organ</oboInOwl:hasRelatedSynonym>
