    <!-- http://purl.obolibrary.org/obo/ENVO_01000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002007"/>
        <obo:IAO_0000115>Hydrogenous sediment is derived from solutes that precipitate out of sea water by a variety of chemical reactions. These are typically less abundant than other sediment types.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-17T01:14:02Z</oboInOwl:creation_date>
