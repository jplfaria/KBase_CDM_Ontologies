        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8166-0486"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1072-8081"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-07T18:43:55Z</dc:date>
        <oboInOwl:hasBroadSynonym xml:lang="de">Verfangen</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Verhedderung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="de">Verstrickung</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">proceso de enredamiento</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="it">processo di impigliamento</oboInOwl:hasExactSynonym>
