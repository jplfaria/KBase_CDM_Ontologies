    <!-- http://purl.obolibrary.org/obo/ENVO_02000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000006"/>
        <obo:IAO_0000115>A termite nest that is built above ground, and is made of soil, saliva, and feces, formed as a large mound.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-05T20:09:16Z</terms:created>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
