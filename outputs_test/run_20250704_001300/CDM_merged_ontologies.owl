    <!-- http://purl.obolibrary.org/obo/ENVO_02000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000127"/>
        <obo:IAO_0000115>a material leftover from the process of reducing sulfur dioxide emissions from a coal-fired boiler that can be a wet sludge consisting of calcium sulfite or calcium sulfate or a dry powered material that is a mixture of sulfites and sulfates.</obo:IAO_0000115>
