        </rdfs:subClassOf>
        <obo:IAO_0000115>An ice calving process during which a mass of ice falls from a larger mass into a body of water.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-24T17:36:27Z</dc:date>
