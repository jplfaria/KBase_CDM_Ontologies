            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake which is primarily composed of glacial meltwater and which fills a depression formed as a result of a glacial erosion process.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
