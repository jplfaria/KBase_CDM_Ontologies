                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The postcranial subdivision of skeleton structural components forming the long axis of the vertebrate body; in Danio, consisting of the notochord, vertebrae, ribs, supraneurals, intermuscular bones, and unpaired median fins; in human consists of the bones of the vertebral column, the thoracic cage and the pelvis[ZFA+FMA].</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>axial skeleton</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>post-cranial axial skeleton</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>postcranial axial skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010912"/>
