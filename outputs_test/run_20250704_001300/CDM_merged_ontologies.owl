            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The foremost region of the future forebrain that develops into the diencephalon.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>presumptive diencephalon</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>future diencephalon</rdfs:label>
    </owl:Class>
    


