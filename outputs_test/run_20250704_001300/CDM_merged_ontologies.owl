        <obo:IAO_0000115>A layer which is composed of ground that is 1) subject to annual thawing and freezing and 2) present in areas underlain by permafrost.</obo:IAO_0000115>
        <obo:IAO_0000116>Potential synonyms are seasonal frost, frost zone, and mollisol. See issue #741 in GitHub for additional details.  These synonyms should be validated in a cryohackathon.</obo:IAO_0000116>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-1264-1166"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-08T05:22:28Z</dc:date>
        <oboInOwl:hasExactSynonym>active layer of permafrost</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605014"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoNceas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">active permafrost layer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_04000009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A layer which is composed of ground that is 1) subject to annual thawing and freezing and 2) present in areas underlain by permafrost.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://nsidc.org/cryosphere/glossary/term/active-layer</oboInOwl:hasDbXref>
    </owl:Axiom>
    


