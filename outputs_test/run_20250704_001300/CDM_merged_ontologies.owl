        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass fluid flow which moves  in the same direction as a planet&apos;s rotation, rotating due to a Coriolis effect.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://glossary.ametsoc.org/wiki/Cyclonic_circulation"/>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Cyclonic_rotation"/>
    </owl:Axiom>
    


