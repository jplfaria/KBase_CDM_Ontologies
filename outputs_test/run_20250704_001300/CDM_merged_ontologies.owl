        <oboInOwl:hasDbXref>https://www.treehugger.com/what-is-freezing-fog-4863382</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000138 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000293"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01003002"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
