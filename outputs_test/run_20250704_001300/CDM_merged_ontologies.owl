            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any portion of the organ that covers that body and consists of a layer of epidermis and a layer of dermis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>portion of skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>region of skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skin region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skin zone</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>zone of skin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000047"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004121"/>
