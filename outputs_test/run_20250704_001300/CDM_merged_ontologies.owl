        <oboInOwl:hasRelatedSynonym>integumental organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pelt</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skin</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
