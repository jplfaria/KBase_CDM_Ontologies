    <!-- http://purl.obolibrary.org/obo/PATO_0001387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001385"/>
        <obo:IAO_0000115>An aneuploidy quality inhering in a bearer by virtue of the bearer&apos;s containing only two chromosome from a pair in a cell&apos;s nucleus.</obo:IAO_0000115>
