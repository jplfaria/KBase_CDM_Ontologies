        <oboInOwl:hasNarrowSynonym xml:lang="en">liquid manure</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">Most manure consists of animal feces; other sources include compost and green manure.</rdfs:comment>
