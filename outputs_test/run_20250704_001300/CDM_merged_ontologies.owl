        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lake which is contained in a depression formed by the deformation and resulting lateral and vertical movements of a lithosphere.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Lake#Tectonic_lakes</oboInOwl:hasDbXref>
    </owl:Axiom>
    


