    <!-- http://purl.obolibrary.org/obo/PATO_0001739 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
