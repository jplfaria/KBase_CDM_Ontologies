        <oboInOwl:hasDbXref>PMID:30715238</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0070019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0070017"/>
        <obo:IAO_0000115>A pyramidal cell morphology that inheres in neurons which lack a clear tuft formation but extend to large radial distances.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasDbXref>ilxtr:UntuftedPyramidalPhenotype</oboInOwl:hasDbXref>
