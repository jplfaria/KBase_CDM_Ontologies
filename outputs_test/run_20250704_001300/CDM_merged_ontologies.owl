    <!-- http://purl.obolibrary.org/obo/ENVO_00000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001305"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001206"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An area in which grasses (Graminae) are a significant component of the vegetation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>grazing area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>herbaceous area</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>grassland area</rdfs:label>
    </owl:Class>
