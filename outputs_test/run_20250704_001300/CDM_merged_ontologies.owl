        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03501300"/>
        <obo:IAO_0000115 xml:lang="en">Manure which is derived from the waste products of animals.</obo:IAO_0000115>
        <rdfs:comment>This is interesting in that the &quot;role&quot; aspect of &quot;waste&quot; is (or can be) replaced by another role &quot;fertilizer&quot;. Thus, the positioning of &quot;manure&quot; under waste may not be totally correct.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>animal manure</rdfs:label>
    </owl:Class>
    


