        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Subglacial_lake</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500028"/>
