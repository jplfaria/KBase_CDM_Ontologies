    <!-- http://purl.obolibrary.org/obo/ENVO_01000629 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
        <rdfs:subClassOf>
