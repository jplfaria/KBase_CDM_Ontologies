        <oboInOwl:hasRelatedSynonym>spiral septa</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>cardiac septum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002100">
