    <!-- http://purl.obolibrary.org/obo/PATO_0045090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0045090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000039"/>
        <obo:IAO_0000115>The four cardinal directions or cardinal points are the directions north, east, south, and west, commonly denoted by their initials, N, E, S, W. East and west are at right angles to north and south, with east being in the clockwise direction of rotation from north and west being directly opposite east.</obo:IAO_0000115>
