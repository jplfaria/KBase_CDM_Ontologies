    <!-- http://purl.obolibrary.org/obo/ENVO_00000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000097"/>
        <obo:IAO_0000115>A desert plain characterized by a surface veneer of gravel or stones.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>desert</oboInOwl:hasBroadSynonym>
