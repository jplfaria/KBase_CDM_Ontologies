        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-05T02:58:43Z</oboInOwl:creation_date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ro/ro-base.owl"/>
        <rdfs:label>is causal germline mutation partially giving rise to</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.orpha.net/ORDO/Orphanet_317346"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004017 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004017">
