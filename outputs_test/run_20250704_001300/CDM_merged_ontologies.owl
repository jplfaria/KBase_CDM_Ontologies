        <oboInOwl:hasExactSynonym>melt ponds</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meltpond</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meltponds</oboInOwl:hasExactSynonym>
