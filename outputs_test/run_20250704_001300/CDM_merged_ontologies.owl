        <oboInOwl:hasRelatedSynonym>neural segment</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>neuromere</rdfs:label>
    </owl:Class>
    


