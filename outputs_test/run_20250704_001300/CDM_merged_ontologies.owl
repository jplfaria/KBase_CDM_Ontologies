        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A fog the droplets of which freeze upon contact with exposed objects, forming a coating of rime or glaze.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-0337-8610"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-2282-7215"/>
