    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_2000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_2000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000017"/>
        <obo:IAO_0000115 xml:lang="en">Kinetic energy which is realised through the microscopic motion of particles.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
