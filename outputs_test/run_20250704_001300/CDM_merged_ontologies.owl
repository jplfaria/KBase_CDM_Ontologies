        <obo:IAO_0000115>A lake which is contained in a depression formed by the deformation and resulting lateral and vertical movements of a lithosphere.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">tectonic lake</rdfs:label>
