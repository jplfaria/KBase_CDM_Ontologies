        <obo:IAO_0000115>A glacier which covers an area of greater than 50,000 square kilometers.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FTT:758</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FTT:835</oboInOwl:hasDbXref>
