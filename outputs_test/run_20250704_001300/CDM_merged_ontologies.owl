        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A drylot is an enclosure of limited size usually bare of vegetation and used for fattening livestock.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>URL:http://www.merriam-webster.com/dictionary/drylot</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000077"/>
        <obo:IAO_0000115>A feedlot is a plot of land on which livestock are fattened for market</obo:IAO_0000115>
