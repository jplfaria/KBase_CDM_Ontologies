    <!-- http://purl.obolibrary.org/obo/ENVO_01000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000023"/>
        <obo:IAO_0000115>The oceanic epipelagic zone biome comprises the marine water column offshore, beyond a continental shelf.</obo:IAO_0000115>
        <oboInOwl:created_by>ORCID:0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-15T11:19:19Z</oboInOwl:creation_date>
