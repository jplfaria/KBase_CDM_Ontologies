    <!-- http://purl.obolibrary.org/obo/ENVO_00000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000248"/>
        <obo:IAO_0000115>A tributary valley with the floor at a higher relief than the main channel into which it flows. They are most commonly associated with U-shaped valleys when a tributary glacier flows into a glacier of larger volume.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>valley</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FTT:166</oboInOwl:hasDbXref>
