    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004018 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004018">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-11-05T03:20:29Z</oboInOwl:creation_date>
