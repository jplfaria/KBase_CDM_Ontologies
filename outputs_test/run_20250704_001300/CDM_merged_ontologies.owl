        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605019"/>
        <rdfs:comment>The United States Geological Survey classifies moderately saline water as having around 3,000 to 10,000 ppm (0.3–1%) of dissolved salts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">moderately saline water</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001039 -->

