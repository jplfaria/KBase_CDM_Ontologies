    <!-- http://purl.obolibrary.org/obo/ENVO_00002213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002124"/>
        <obo:IAO_0000115 xml:lang="en">An anaerobic bioreactor which is capable of treating wastewater through the action of methanogenic microbes which form a blanket of sludge due to the upward flow in the reactor.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">This can be unpacked with some hierarchies of different bioreactors.</obo:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>anaerobic sludge blanket reactor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
