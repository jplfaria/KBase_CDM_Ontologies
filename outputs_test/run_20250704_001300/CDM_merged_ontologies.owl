        <oboInOwl:hasRelatedSynonym>embryonic brain</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>future brain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006598"/>
