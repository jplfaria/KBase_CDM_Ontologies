        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A lipid material derived from plants. Physically, oils are liquid at room temperature.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Vegetable_fats_and_oils"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">vegetable oil food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001859"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03420307"/>
        <obo:IAO_0000115 xml:lang="en">An oil used as a nutritional supplement and is a traditional European ethnic food, highly regarded for its nutty flavor.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Linseed_oil#Nutritional_supplement_and_food"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-8844-9165"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-19T21:51:42Z</terms:date>
