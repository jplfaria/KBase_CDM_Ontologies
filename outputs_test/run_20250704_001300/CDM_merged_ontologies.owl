                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Built by fragments (called ejecta) thrown up (ejected) from a volcanic vent, piling up around the vent in the shape of a cone with a central crater.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>cone</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FTT:530</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Geonames:T.CONE</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:VolcanicCone</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGN:21418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Volcanic_cone</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lava cone</oboInOwl:hasExactSynonym>
