            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A part of a lithosphere which is separated by other such parts by geographic faults or similar geomorphological discontinuities.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">tectonic plate</rdfs:label>
