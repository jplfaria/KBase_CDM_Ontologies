        <obo:IAO_0000115>A cloud which develop locally over forests as a result of increased humidity due to evaporation and evapotranspiration from the tree canopy.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAtmo"/>
        <rdfs:comment>These special clouds will be given the name of the appropriate genus, followed by any appropriate species, variety and supplementary feature, and followed by the special cloud name “silvagenitus” (for example, Stratus silvagenitus).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">silvagenitus cloud</rdfs:label>
    </owl:Class>
