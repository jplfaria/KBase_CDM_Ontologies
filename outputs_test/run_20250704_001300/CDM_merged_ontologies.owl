        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000580"/>
        <obo:IAO_0000115>A landline telephone is a telephone which is connected to a telephone network with wires through which electronic signals are carried.</obo:IAO_0000115>
