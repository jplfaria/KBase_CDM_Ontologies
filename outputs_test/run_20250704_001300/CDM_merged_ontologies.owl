    <!-- http://purl.obolibrary.org/obo/RO_0002402 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002402">
        <obo:IAO_0000112>translation SubClassOf has_direct_output some protein</obo:IAO_0000112>
