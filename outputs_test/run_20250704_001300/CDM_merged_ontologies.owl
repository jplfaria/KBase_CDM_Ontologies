        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000243"/>
        <obo:IAO_0000115>A class of complex shallow wetlands in central, southern and eastern Africa, particularly in Zambia and Zimbabwe. They are generally found in higher rainfall flat plateau areas, and have river-like branching forms which may be nowhere very large, but common enough to add up to a large area.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>dambo</rdfs:label>
    </owl:Class>
