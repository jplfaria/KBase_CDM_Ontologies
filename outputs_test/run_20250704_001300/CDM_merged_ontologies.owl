        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115>A flammable liquid hydrocarbon mixture produced from natural gas condensates, petroleum distillates, and the distillation of coal tar and peat.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-7463-6306"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-03T18:26:21Z</dc:date>
