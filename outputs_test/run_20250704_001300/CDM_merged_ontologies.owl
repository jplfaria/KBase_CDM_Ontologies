            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Leaf litter is dead plant material, such as leaves, bark, needles, and twigs, that has fallen to the ground.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>duff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leaf litter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>litterfall</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>soil litter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tree litter</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605024"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">plant litter</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000628"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Leaf litter is dead plant material, such as leaves, bark, needles, and twigs, that has fallen to the ground.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Plant_litter</oboInOwl:hasDbXref>
