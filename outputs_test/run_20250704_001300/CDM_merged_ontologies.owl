        <rdfs:label>results in synthesis of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002588 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002588">
