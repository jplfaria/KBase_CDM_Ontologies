        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-03-15T04:00:01.750Z</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">&quot;an enclosure or compartment that allows privacy or seclusion, for example when voting, broadcasting or recording sound, or making a phone call.&quot; OED I like this one more - except it doesn&apos;t fit &quot;ticket booth&quot;, &quot;gas station booth&quot; etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">booth</rdfs:label>
    </owl:Class>
    


