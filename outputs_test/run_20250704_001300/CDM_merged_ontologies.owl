            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A freshwater ecosystem which has its functions and composition determined by a freshwater lake.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-06T13:53:58Z</dc:date>
