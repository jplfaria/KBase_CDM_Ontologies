    <!-- http://purl.obolibrary.org/obo/ENVO_01000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001677"/>
