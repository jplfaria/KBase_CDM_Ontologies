        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ice formation process during which water is frozen into a form of new ice such as frazil, grease ice, slush, or shuga.</owl:annotatedTarget>
