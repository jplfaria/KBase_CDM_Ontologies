    <!-- http://purl.obolibrary.org/obo/ENVO_03000056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000950"/>
