                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007237"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The paired ventral prominences formed by bifurcation of the first pharyngeal arches in the embryo; the two prominences unite ventrally and fuse to form the mandible and lower lip.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>mandibular process</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mandibular swelling</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prominentia mandibularis</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>mandibular prominence</rdfs:label>
    </owl:Class>
    


