            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The planting of trees in areas in where forests have previously been cleared.</obo:IAO_0000115>
        <rdfs:comment>reforestation is reestablishment of forest where the forest recently existed[IPCC]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>reforestation</rdfs:label>
    </owl:Class>
