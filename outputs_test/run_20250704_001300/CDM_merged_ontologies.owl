        <obo:IAO_0000115>A mass fluid flow which moves  in the same direction as a planet&apos;s rotation, rotating due to a Coriolis effect.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-09-05T05:47:55Z</dc:date>
