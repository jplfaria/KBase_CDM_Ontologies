        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A1061"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">50190000 - prepared/preserved foods (gs1 gpc)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03401095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03401095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401061"/>
