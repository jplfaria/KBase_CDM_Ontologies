            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tectonic uplift process is a geomorphologic process in which a geological surface shifts upward relative to a datum such as sea-level due to forces other than isostatic responses to unloading.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">tectonic uplift process</rdfs:label>
    </owl:Class>
