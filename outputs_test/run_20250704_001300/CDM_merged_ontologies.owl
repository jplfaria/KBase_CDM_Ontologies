    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001102"/>
        <obo:IAO_0000115>The liquid extracted from the mashing process during the brewing of beer or whiskey. Wort contains the sugars that will be fermented by the brewing yeast to produce alcohol.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">wort food product</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The liquid extracted from the mashing process during the brewing of beer or whiskey. Wort contains the sugars that will be fermented by the brewing yeast to produce alcohol.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Wort_%28brewing%29</oboInOwl:hasDbXref>
    </owl:Axiom>
    


