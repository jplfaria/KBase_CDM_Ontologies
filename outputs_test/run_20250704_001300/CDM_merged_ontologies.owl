                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00002001"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000600"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000722"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001267"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Liquid water which 1) flows over land and 2) is not absorbed or retained by the materials if flows over or through.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0001-6284-4821"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-18T17:01:38Z</dc:date>
        <oboInOwl:hasExactSynonym xml:lang="en">overland flow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">surface runoff</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ENVO_03605019"/>
        <rdfs:comment xml:lang="en">Runoff often gathers debris and solutes from the materials it flows over or through, and often flows into a water body.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">runoff</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_06105211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Liquid water which 1) flows over land and 2) is not absorbed or retained by the materials if flows over or through.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/w/index.php?title=Surface_runoff&amp;oldid=1053883452"/>
        <oboInOwl:hasDbXref rdf:resource="https://pesticidestewardship.org/water/runoff/"/>
        <oboInOwl:hasDbXref rdf:resource="https://www.merriam-webster.com/dictionary/runoff"/>
    </owl:Axiom>
    


