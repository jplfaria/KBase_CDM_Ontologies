        </rdfs:subClassOf>
        <obo:IAO_0000115>A crater caused by the impact of a meteor.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SWEETRealm:ImpactCrater</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Impact_crater</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>meteorite crater</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meteorite impact crater</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meteoroid impact crater</oboInOwl:hasExactSynonym>
