            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The dermis is a layer of skin between the epidermis (with which it makes up the skin) and subcutaneous tissues, and is composed of two layers, the papillary and reticular dermis[WP].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>vertebrate dermis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>corium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cutis</oboInOwl:hasRelatedSynonym>
