    <!-- http://purl.obolibrary.org/obo/ENVO_01000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000203"/>
        <obo:IAO_0000115>A polar condition is an environmental condition in which an environmental system receives low, yearly solar irradiance per unit area, resulting in colder climatic conditions.</obo:IAO_0000115>
        <dc:creator rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:creation_date>2013-05-08T07:49:36Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>SPIRE:Polar</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:Polarization</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>frigid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>On Earth, polar conditions are such that every month has average temperature lower than 10 degrees Celsius. Note that  this class refers to a climatic rather than a positional condition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>polar</rdfs:label>
    </owl:Class>
