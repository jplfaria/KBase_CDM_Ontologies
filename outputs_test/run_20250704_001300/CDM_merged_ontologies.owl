                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
