    <!-- http://purl.obolibrary.org/obo/ENVO_00000511 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000044"/>
        <obo:IAO_0000115>A peatland whose development is mostly independent of basins or topographical features where water collects; it simply covers the landscape like a blanket. Peat develops due to a continuous supply of water from rainfall, maintaining waterlogged conditions on the ground. Blanket bogs are ombrotrophic or rain fed, and as a result their pH lies between 3.5 and 4.2.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>wetland</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SWEETRealm:BlanketBog</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Blanket_bog</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ENVO:00000511</oboInOwl:id>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>blanket bog</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A peatland whose development is mostly independent of basins or topographical features where water collects; it simply covers the landscape like a blanket. Peat develops due to a continuous supply of water from rainfall, maintaining waterlogged conditions on the ground. Blanket bogs are ombrotrophic or rain fed, and as a result their pH lies between 3.5 and 4.2.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>IPCC:http://www.ipcc.ie/infoblanketbogfs.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000511"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>wetland</owl:annotatedTarget>
        <oboInOwl:hasDbXref>USGS:SDTS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


