    <!-- http://purl.obolibrary.org/obo/IAO_0000646 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <obo:IAO_0000115 xml:lang="en">An identifier that denotes some postal delivery route, some aggregate of postal delivery routes or a geographical region and was created for the purpose of sorting and delivering mail.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">postal code</rdfs:label>
