    <!-- http://purl.obolibrary.org/obo/ENVO_01001447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001436"/>
