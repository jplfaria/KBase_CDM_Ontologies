        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/List_of_custard_desserts"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001041"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02000412"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Beef that has been ground.</obo:IAO_0000115>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Ground_beef</obo:IAO_0000119>
        <schema:image rdf:resource="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Hackfleisch-1.jpg/631px-Hackfleisch-1.jpg"/>
        <oboInOwl:hasExactSynonym>beef mince</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">beef mince</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ground beef</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hamburger meat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>minced beef</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">A ground beef product is made of beef that has been finely chopped with a knife or a meat grinder (American English) or mincing machine (British English). Ground beef is used in many recipes including hamburgers and spaghetti Bolognese.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">beef (ground)</rdfs:label>
    </owl:Class>
    


