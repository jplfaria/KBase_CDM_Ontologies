            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Transpiration is the process of water movement through a plant and its evaporation from aerial parts of that plant, such as from leaves but also from stems and flowers.</obo:IAO_0000115>
        <rdfs:comment>Needs a process part &quot;water transport&quot; or similar and some link to plants to be complete.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>transpiration</rdfs:label>
    </owl:Class>
    


