    <!-- http://purl.obolibrary.org/obo/ENVO_01001400 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001428"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001159"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An aeroform which is formed as a result of strong upper winds spreading a cirrus homogenitus cloud in the atmosphere and, in turn, causing internal tranformations which result in the cloud taking on the appearnce of natural cirri-form clouds.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoAtmo"/>
        <rdfs:comment>Once these clouds resemble natural cirri-form clouds (Cirrus, Cirrocumulus, Cirrostratus), they are classified as such.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">homomutatus cloud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001400"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An aeroform which is formed as a result of strong upper winds spreading a cirrus homogenitus cloud in the atmosphere and, in turn, causing internal tranformations which result in the cloud taking on the appearnce of natural cirri-form clouds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://cloudatlas.wmo.int/homomutatus.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


