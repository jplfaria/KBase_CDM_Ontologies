        <oboInOwl:hasExactSynonym xml:lang="en">cool room</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">refrigerating chamber</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Cold rooms are generally used as walk-in storage facilities or to perform tasks requiring cooler ambient temperatures.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">cold room</rdfs:label>
    </owl:Class>
