        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Land which is covered or partially covered by snow.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-0337-8610"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-2282-7215"/>
