            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002479"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process during which pieces of a planetary crust and uppermost mantle move towards one another.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">convergent tectonic movement</rdfs:label>
