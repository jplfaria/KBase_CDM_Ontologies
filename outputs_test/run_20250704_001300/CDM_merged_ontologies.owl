    <!-- http://purl.obolibrary.org/obo/ENVO_21001216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_21001216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001026"/>
