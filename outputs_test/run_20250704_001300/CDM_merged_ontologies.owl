    <!-- http://purl.obolibrary.org/obo/ENVO_03000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000690"/>
        <obo:IAO_0000115>A mass wasting process during which slab snow rapidly moves down a sloping surface.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-4366-3088"/>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#environmental_hazards"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>Slab avalanches account for most back-country fatalities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">slab avalanche</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000105"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mass wasting process during which slab snow rapidly moves down a sloping surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Snow#Avalanche</oboInOwl:hasDbXref>
