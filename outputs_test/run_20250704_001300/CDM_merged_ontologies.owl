        <obo:IAO_0000115 xml:lang="en">A one-dimensional temporal region during which an entity is exposed to stellar radiation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>sunshine hours</oboInOwl:hasExactSynonym>
