        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001248"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A fish product is a home-made or commercially produced or retail or wholesale product containing substantial amounts of freshwater or saltwater fish and/or shellfish flesh. Note that this category should avoid items that mention a particular species of fish or shellfish.</obo:IAO_0000115>
        <terms:contributor xml:lang="en">Damion Dooley</terms:contributor>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F15173"/>
        <rdfs:comment xml:lang="en">SIREN DB annotation:
* skeletal meat part FOODON:03420175</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label xml:lang="en">fish product (unspecified species)</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Fish_products</rdfs:seeAlso>
    </owl:Class>
    


