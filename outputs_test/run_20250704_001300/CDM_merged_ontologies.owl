            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Anatomical structure that is part of the head consisting entirely of cranium and mandible[WP].</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>cranial skeleton</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skeletal system of head</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>skull</rdfs:label>
    </owl:Class>
    


