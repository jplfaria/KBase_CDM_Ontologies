            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Rock formed from molten magma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EcoLexicon:igneous_rock</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SWEETRealm:IgneousRock</oboInOwl:hasDbXref>
