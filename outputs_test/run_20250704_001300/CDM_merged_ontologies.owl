    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0013006 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0013006">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0013003"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0013004"/>
        <obo:IAO_0000115>A relationship between a neuron and a region, where the neuron has a functionally relevant number output synapses distributed throughout that region (rather than confined to a subregion).</obo:IAO_0000115>
