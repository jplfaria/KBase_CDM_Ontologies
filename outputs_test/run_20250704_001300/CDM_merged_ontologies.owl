        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental material which is in a liquid state.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/envo#envoPolar"/>
        <rdfs:comment>This is a defined class: most of its subclasses will not be asserted, but filled by inference.</rdfs:comment>
